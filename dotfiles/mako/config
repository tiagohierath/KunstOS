# KunstOS notifications: styled like the fuzzel menu (Gruvbox, blue border, green highlight)
font=Cascadia Code 14
background-color=#282828
text-color=#ebdbb2
border-color=#83a598
border-size=1
border-radius=0
padding=12,16
margin=10
width=420
max-icon-size=48
default-timeout=5000
progress-color=over #504945
format=<span color="#b8bb26"><b>%s</b></span>\n%b

[urgency=critical]
border-color=#fb4934
default-timeout=0
