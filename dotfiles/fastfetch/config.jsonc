// KunstOS fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/kunstos/fastfetch/logo.txt",
    "color": { "1": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "red" }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[1;31mKunst\u001b[33mOS\u001b[0m" },
    { "type": "custom", "format": "\u001b[33m─────────────────────────────────\u001b[0m" },
    { "type": "os",       "key": "os      " },
    { "type": "kernel",   "key": "kernel  " },
    { "type": "wm",       "key": "wm      " },
    { "type": "terminal", "key": "terminal" },
    { "type": "packages", "key": "packages" },
    { "type": "cpu",      "key": "cpu     " },
    { "type": "gpu",      "key": "gpu     " },
    { "type": "memory",   "key": "memory  " },
    { "type": "display",  "key": "display " },
    { "type": "uptime",   "key": "uptime  " },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
