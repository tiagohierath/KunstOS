#!/usr/bin/env bash
# KunstOS app installer: pick apps one by one, or "All ..." to take a whole pack.
# The picked apps go to /etc/nixos/kunstos-apps.json and the system is rebuilt.
# Without that file (not KunstOS) it only shows what it would install.
packs=${KUNST_PACKS:-$(dirname "$(readlink -f "$0")")/../packs/packs.json}
state=/etc/nixos/kunstos-apps.json

export GUM_CHOOSE_HEADER_FOREGROUND="#83a598" GUM_CHOOSE_CURSOR_FOREGROUND="#fabd2f" \
    GUM_CHOOSE_SELECTED_FOREGROUND="#b8bb26" GUM_CHOOSE_ITEM_FOREGROUND="#ebdbb2" \
    GUM_CONFIRM_PROMPT_FOREGROUND="#ebdbb2" GUM_CONFIRM_SELECTED_BACKGROUND="#b8bb26" \
    GUM_CONFIRM_SELECTED_FOREGROUND="#282828" GUM_CONFIRM_UNSELECTED_BACKGROUND="#504945" \
    GUM_CONFIRM_UNSELECTED_FOREGROUND="#ebdbb2"

installed=$(jq -r '.[]' "$state" 2>/dev/null)
items=$(jq -r '.[] | ("All " + .title + "|@" + .title), (.apps[] | ("  " + .name + "|" + .pkg))' "$packs")
selected=$(jq -r --arg installed "$installed" \
    '[.[].apps[] | select(.pkg as $p | $installed | split("\n") | index($p)) | "  " + .name] | join(",")' "$packs")

picked=$(gum choose --no-limit --no-show-help --height=30 --label-delimiter="|" --selected="$selected" \
    --header="KunstOS apps   space: select   enter: install   esc: quit" <<<"$items") || exit 0

# "@pack" means every app in that pack
apps=$(jq -r --arg picked "$picked" '($picked | split("\n")) as $p
    | .[] | .title as $t | .apps[] | select((.pkg as $k | $p | index($k)) or ($p | index("@" + $t)))
    | .pkg + "\t" + .name' "$packs")

echo "Apps after this:"
{ [ -n "$apps" ] && cut -f2 <<<"$apps" || echo "(none)"; } | sed 's/^/  /'
[ -f "$state" ] || { echo; echo "Not KunstOS ($state is missing), so nothing was installed."; exit 0; }
gum confirm "Install?" || exit 0
cut -f1 <<<"$apps" | jq -R . | jq -s 'map(select(. != ""))' | sudo tee "$state" >/dev/null &&
    sudo nixos-rebuild switch --impure --flake /etc/nixos#kunstos
