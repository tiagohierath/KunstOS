#!/usr/bin/env bash
# Fresh-install apps: every pack marked "default" in packs/packs.json, minus apps marked
# "optional" (the fun tinkering tools, minus the optional ones). Writes them to /etc/nixos/kunstos-apps.json and rebuilds, the same way kunst-apps does.
# The apps download during the install, so they don't add to the size of the ISO.
# Stops before touching /etc if anything fails, so a broken run can't write an empty list.
set -euo pipefail
packs=$(dirname "$(readlink -f "$0")")/../packs/packs.json
state=/etc/nixos/kunstos-apps.json

# The live ISO has no /etc/nixos flake: nothing to install there.
[ -e /etc/nixos/flake.nix ] || { echo "This is the live system. Apps install after KunstOS is installed."; exit 0; }

json=$(jq '[.[] | select(.default) | .apps[] | select(.optional | not) | .pkg]' "$packs")
sudo tee "$state" <<<"$json" >/dev/null
sudo nixos-rebuild switch --impure --flake /etc/nixos#kunstos
