// KunstOS fastfetch, 2x version of config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/projects/kunstOS/dotfiles/fastfetch/logo-2x.txt",
    "color": { "1": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "red" }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[1;31mk u n s t \u001b[33mO S\u001b[0m" },
    { "type": "custom", "format": "\u001b[33m─────────────────────────────────\u001b[0m" },
    { "type": "os",           "key": "os           " },
    { "type": "host",         "key": "host         " },
    { "type": "kernel",       "key": "kernel       " },
    { "type": "initsystem",   "key": "init system  " },
    { "type": "wm",           "key": "wm           " },
    { "type": "cursor",       "key": "cursor       " },
    { "type": "terminal",     "key": "terminal     " },
    { "type": "terminalfont", "key": "terminal font" },
    { "type": "shell",        "key": "shell        " },
    { "type": "packages",     "key": "packages     " },
    { "type": "cpu",          "key": "cpu          " },
    { "type": "gpu",          "key": "gpu          " },
    { "type": "opengl",       "key": "opengl       " },
    { "type": "memory",       "key": "memory       " },
    { "type": "swap",         "key": "swap         " },
    { "type": "disk",         "key": "disk         " },
    { "type": "display",      "key": "display      " },
    { "type": "brightness",   "key": "brightness   " },
    { "type": "battery",      "key": "battery      " },
    { "type": "uptime",       "key": "uptime       " },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
