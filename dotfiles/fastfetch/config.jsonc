// KunstOS fastfetch: a painter's palette in Gruvbox
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/projects/kunstOS/dotfiles/fastfetch/logo.txt",
    "color": { "1": "white", "2": "red", "3": "yellow", "4": "green", "5": "blue", "6": "magenta" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "red" }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[1;31mk u n s t \u001b[33mO S\u001b[0m   for people who paint" },
    { "type": "custom", "format": "\u001b[33m─────────────────────────────────\u001b[0m" },
    { "type": "os",       "key": "system " },
    { "type": "kernel",   "key": "kernel " },
    { "type": "wm",       "key": "canvas " },
    { "type": "terminal", "key": "brush  " },
    { "type": "packages", "key": "paints " },
    { "type": "cpu",      "key": "cpu    " },
    { "type": "gpu",      "key": "gpu    " },
    { "type": "memory",   "key": "memory " },
    { "type": "display",  "key": "screen " },
    { "type": "uptime",   "key": "studio " },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
